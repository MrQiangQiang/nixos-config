diff --git a/src/ui/input/buffer.rs b/src/ui/input/buffer.rs
index 519013c..2fa621f 100644
--- a/src/ui/input/buffer.rs
+++ b/src/ui/input/buffer.rs
@@ -37,6 +37,16 @@ impl InputBuffer {
         &self.value
     }
 
+    /// Returns the visible display-width offset of the cursor from the start
+    /// of the visible slice. Used to position the terminal cursor for IME.
+    pub fn visible_cursor_x(&self) -> u16 {
+        if self.cursor <= self.visible_slice.start {
+            return 0;
+        }
+        let end = self.cursor.min(self.visible_slice.end);
+        self.value[self.visible_slice.start..end].width() as u16
+    }
+
     pub(super) fn set_value(&mut self, new_value: String) {
         self.cursor = new_value.len();
         self.value = new_value;
