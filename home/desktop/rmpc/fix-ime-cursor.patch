+
+        // Position the real terminal cursor at the active input field so IME
+        // (e.g. fcitx5) can anchor its candidate window. Without this, the
+        // cursor stays wherever the last cell was drawn, causing the candidate
+        // window to jump around on every keystroke.
+        if let Some(id) = self.buffer_id
+            && self.ctx.input.is_active(id)
+        {
+            let border_offset = u16::from(!self.borderless);
+            let x = input_area.x + border_offset + self.ctx.input.visible_cursor_x(id);
+            let y = input_area.y + border_offset;
+            self.ctx.input.set_cursor_position(Position { x, y });
+        }
     }
