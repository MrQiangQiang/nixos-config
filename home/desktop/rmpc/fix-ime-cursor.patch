+    /// Stores the terminal cursor position for the active input field.
+    /// Called during render; consumed by the event loop after `terminal.draw`.
+    pub fn set_cursor_position(&self, pos: Position) {
+        self.cursor_position.set(Some(pos));
+    }
+
+    /// Consumes the stored cursor position, if any. Returns None when no
+    /// input field was active during the last render.
+    pub fn take_cursor_position(&self) -> Option<Position> {
+        self.cursor_position.take()
+    }
+
+    /// Returns the display-width offset of the cursor within the visible
+    /// portion of the buffer with the given id.
+    pub fn visible_cursor_x(&self, id: BufferId) -> u16 {
+        self.buffers.borrow().get(&id).map_or(0, InputBuffer::visible_cursor_x)
+    }
+
     pub fn destroy_buffer(&self, id: BufferId) {
