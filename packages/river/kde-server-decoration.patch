diff --git a/river/ServerDecoration.zig b/river/ServerDecoration.zig
new file mode 100644
index 0000000..1d1347d
--- /dev/null
+++ b/river/ServerDecoration.zig
@@ -0,0 +1,111 @@
+// SPDX-FileCopyrightText: © 2025 The River Developers
+// SPDX-License-Identifier: GPL-3.0-only
+
+const ServerDecoration = @This();
+
+const std = @import("std");
+const wl = @import("wayland").server.wl;
+const org = @import("wayland").server.org;
+
+const server = &@import("main.zig").server;
+
+const log = std.log.scoped(.server_decoration);
+
+global: *wl.Global,
+server_destroy: wl.Listener(*wl.Server) = .init(handleServerDestroy),
+
+manager_objects: wl.list.Head(org.KdeKwinServerDecorationManager, null),
+decoration_objects: wl.list.Head(org.KdeKwinServerDecoration, null),
+
+pub fn init(kde_sd: *ServerDecoration, wl_server: *wl.Server) !void {
+    kde_sd.* = .{
+        .global = try wl.Global.create(
+            wl_server,
+            org.KdeKwinServerDecorationManager,
+            1,
+            *ServerDecoration,
+            kde_sd,
+            bindManager,
+        ),
+        .manager_objects = undefined,
+        .decoration_objects = undefined,
+    };
+    kde_sd.manager_objects.init();
+    kde_sd.decoration_objects.init();
+
+    wl_server.addDestroyListener(&kde_sd.server_destroy);
+}
+
+fn handleServerDestroy(listener: *wl.Listener(*wl.Server), _: *wl.Server) void {
+    const kde_sd: *ServerDecoration = @fieldParentPtr("server_destroy", listener);
+
+    kde_sd.global.destroy();
+
+    while (kde_sd.manager_objects.first()) |object| object.destroy();
+    while (kde_sd.decoration_objects.first()) |object| object.destroy();
+}
+
+fn bindManager(client: *wl.Client, kde_sd: *ServerDecoration, version: u32, id: u32) void {
+    const manager = org.KdeKwinServerDecorationManager.create(client, version, id) catch {
+        client.postNoMemory();
+        log.err("out of memory", .{});
+        return;
+    };
+    manager.setHandler(*ServerDecoration, handleManagerRequest, handleManagerDestroy, kde_sd);
+    kde_sd.manager_objects.append(manager);
+
+    // Always advertise Server as the default mode.
+    // This causes GTK3's gdk_wayland_display_prefers_ssd() to return TRUE,
+    // preventing GTK3 from creating CSD decoration widgets.
+    manager.sendDefaultMode(.Server);
+}
+
+fn handleManagerRequest(
+    manager: *org.KdeKwinServerDecorationManager,
+    request: org.KdeKwinServerDecorationManager.Request,
+    kde_sd: *ServerDecoration,
+) void {
+    switch (request) {
+        .create => |args| {
+            const decoration = org.KdeKwinServerDecoration.create(
+                manager.getClient(),
+                manager.getVersion(),
+                args.id,
+            ) catch {
+                manager.getClient().postNoMemory();
+                log.err("out of memory", .{});
+                return;
+            };
+            decoration.setHandler(*ServerDecoration, handleDecorationRequest, handleDecorationDestroy, kde_sd);
+            kde_sd.decoration_objects.append(decoration);
+
+            // Always respond with Server mode.
+            // Ignore the client's requested mode since River always uses SSD.
+            decoration.sendMode(.Server);
+        },
+    }
+}
+
+fn handleManagerDestroy(manager: *org.KdeKwinServerDecorationManager, _: *ServerDecoration) void {
+    manager.getLink().remove();
+}
+
+fn handleDecorationRequest(
+    decoration: *org.KdeKwinServerDecoration,
+    request: org.KdeKwinServerDecoration.Request,
+    _: *ServerDecoration,
+) void {
+    switch (request) {
+        .request_mode => {
+            // Ignore the client's requested mode. Always respond with Server.
+            decoration.sendMode(.Server);
+        },
+        .release => {
+            decoration.destroy();
+        },
+    }
+}
+
+fn handleDecorationDestroy(decoration: *org.KdeKwinServerDecoration, _: *ServerDecoration) void {
+    decoration.getLink().remove();
+}
