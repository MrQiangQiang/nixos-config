diff --git a/protocol/upstream/server-decoration.xml b/protocol/upstream/server-decoration.xml
new file mode 100644
index 0000000..26bff42
--- /dev/null
+++ b/protocol/upstream/server-decoration.xml
@@ -0,0 +1,52 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="server_decoration">
+  <copyright><![CDATA[
+    SPDX-FileCopyrightText: 2015 Martin Gräßlin
+    SPDX-License-Identifier: LGPL-2.1-or-later
+  ]]></copyright>
+
+  <interface name="org_kde_kwin_server_decoration_manager" version="1">
+    <description summary="Server side window decoration manager">
+      This interface allows to coordinate whether the server should create
+      a server-side window decoration around a wl_surface representing a
+      shell surface.
+      Use in conjunction with zxdg_decoration_manager_v1 is undefined.
+    </description>
+    <request name="create">
+      <description summary="Create a server-side decoration object for a given surface">
+        When a client creates a server-side decoration object it indicates
+        that it supports the protocol. The client is supposed to tell the
+        server whether it wants server-side decorations or will provide
+        client-side decorations.
+      </description>
+      <arg name="id" type="new_id" interface="org_kde_kwin_server_decoration"/>
+      <arg name="surface" type="object" interface="wl_surface"/>
+    </request>
+    <enum name="mode">
+      <entry name="None" value="0" summary="Undecorated"/>
+      <entry name="Client" value="1" summary="Client-side decoration"/>
+      <entry name="Server" value="2" summary="Server-side decoration"/>
+    </enum>
+    <event name="default_mode">
+      <description summary="The default mode used on the server"/>
+      <arg name="mode" type="uint" enum="mode"/>
+    </event>
+  </interface>
+
+  <interface name="org_kde_kwin_server_decoration" version="1">
+    <request name="release" type="destructor"/>
+    <enum name="mode">
+      <entry name="None" value="0"/>
+      <entry name="Client" value="1"/>
+      <entry name="Server" value="2"/>
+    </enum>
+    <request name="request_mode">
+      <description summary="The decoration mode the surface wants to use."/>
+      <arg name="mode" type="uint" enum="mode"/>
+    </request>
+    <event name="mode">
+      <description summary="The new decoration mode applied by the server"/>
+      <arg name="mode" type="uint" enum="mode"/>
+    </event>
+  </interface>
+</protocol>
